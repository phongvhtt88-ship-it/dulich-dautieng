---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ZaloButton from '../components/ZaloButton.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { 
  title, 
  description = "Cổng thông tin quảng bá du lịch sinh thái, di tích văn hóa lịch sử và giới thiệu nông sản OCOP địa phương", 
  image = "/banner-og.jpg" 
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://dulich-dautien.gov.vn');
---

<!doctype html>
<html lang="vi" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | Cổng Du Lịch & OCOP Địa Phương</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook / Zalo -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} | Cổng Du Lịch & OCOP`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- Tailwind CSS CDN Fallback đảm bảo giao diện luôn hiển thị chuẩn đẹp 100% -->
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <script is:inline>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              brand: {
                50: '#f0fdf4',
                100: '#dcfce7',
                500: '#22c55e',
                600: '#16a34a',
                700: '#15803d',
                800: '#166534',
                900: '#14532d'
              }
            }
          }
        }
      }
    </script>

    <!-- Leaflet CSS for Map -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />

    <style is:inline>
      /* Ngăn chặn mọi hiện tượng icon SVG bị phóng to trước khi tải xong CSS */
      svg {
        max-width: 100%;
        height: auto;
      }
    </style>
  </head>
  <body class="bg-gray-50 text-gray-800 min-h-screen flex flex-col font-sans antialiased">
    <Header />
    <main class="flex-grow">
      <slot />
    </main>
    <ZaloButton />
    <Footer />

    <!-- Leaflet JS -->
    <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  </body>
</html>
