];

// Dữ liệu sản phẩm OCOP & Nông sản tiêu biểu xã Dầu Tiếng, TP. Hồ Chí Minh
const mockOcop = [
  {
    name: 'Bưởi Da Xanh Dầu Tiếng Đạt Chuẩn VietGAP',
    slug: { current: 'buoi-da-xanh-dau-tieng' },
    starRating: '4',
    producer: 'HTX Nông Nghiệp Dầu Tiếng, TP.HCM',
    priceRange: '50.000đ - 75.000đ/kg',
    phoneContact: '02743561000',
    zaloPhone: '0901234567',
    standards: ['VietGAP', 'OCOP 4 Sao', 'Chuỗi ATTP'],
    mainImage: { asset: { url: 'https://images.unsplash.com/photo-1610832958506-aa56368176cf?w=600&auto=format&fit=crop' } }
  },
  {
    name: 'Măng Cụt Dầu Tiếng Chín Cây Mùa Vụ',
    slug: { current: 'mang-cut-dau-tieng' },
    starRating: '4',
    producer: 'Tổ Hợp Tác Cây Ăn Trái Dầu Tiếng',
    priceRange: '70.000đ - 110.000đ/kg',
    phoneContact: '02743561000',
    zaloPhone: '0987654321',
    standards: ['OCOP 4 Sao', 'Đặc sản tiêu biểu'],
    mainImage: { asset: { url: 'https://images.unsplash.com/photo-1546548970-71785318a17b?w=600&auto=format&fit=crop' } }
  },
  {
    name: 'Mật Ong Rừng & Hoa Cao Su Tự Nhiên Dầu Tiếng',
    slug: { current: 'mat-ong-hoa-rung' },
    starRating: '3',
    producer: 'Hộ Kinh Doanh Nông Lâm Nghiệp Dầu Tiếng',
    priceRange: '200.000đ - 350.000đ/lọ',
    phoneContact: '02743561000',
    zaloPhone: '0912345678',
    standards: ['ATTP', 'OCOP 3 Sao'],
    mainImage: { asset: { url: 'https://images.unsplash.com/photo-1587049352846-4a222e784d38?w=600&auto=format&fit=crop' } }
  },
  {
    name: 'Yến Sào Dầu Tiếng Tinh Chế Nguyên Chất',
    slug: { current: 'yen-sao-dau-tieng' },
    starRating: '4',
    producer: 'Cơ sở Yến Sào Sinh Thái Dầu Tiếng',
    priceRange: '2.800.000đ - 3.500.000đ/100g',
    phoneContact: '02743561000',
    zaloPhone: '0901234567',
    standards: ['OCOP 4 Sao', 'ISO 22000'],
    mainImage: { asset: { url: 'https://images.unsplash.com/photo-1596040033229-a9821ebd058d?w=600&auto=format&fit=crop' } }
  }
];

let spots = mockSpots;
let ocopProducts = mockOcop;

try {
  if (import.meta.env.PUBLIC_SANITY_PROJECT_ID) {
    const fetchedSpots = await sanityClient.fetch(`*[_type == "touristSpot"] | order(_createdAt desc)`);
    if (fetchedSpots && fetchedSpots.length > 0) spots = fetchedSpots;
    
    const fetchedOcop = await sanityClient.fetch(`*[_type == "ocopProduct"] | order(starRating desc)`);
    if (fetchedOcop && fetchedOcop.length > 0) ocopProducts = fetchedOcop;
  }
} catch (e) {}
---

<Layout title="Trang chủ">
  
  <!-- HERO BANNER -->
  <section class="relative bg-gradient-to-br from-brand-900 via-brand-800 to-emerald-950 text-white py-20 sm:py-28 overflow-hidden">
    <div class="absolute inset-0 opacity-15 bg-[radial-gradient(#22c55e_1px,transparent_1px)] [background-size:16px_16px]"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 bg-brand-700/80 backdrop-blur-md px-3.5 py-1.5 rounded-full text-xs font-bold text-green-200 uppercase tracking-widest mb-6 border border-brand-500/30">
          <span>🌿</span> Xã Dầu Tiếng, TP. Hồ Chí Minh
        </div>
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight leading-tight sm:leading-tight">
          Văn Hóa - Du Lịch Ven Hồ & <br />
          <span class="text-green-400">Nông Sản OCOP Dầu Tiếng</span>
        </h1>
        <p class="mt-5 text-base sm:text-lg text-gray-200 leading-relaxed font-normal">
          Chào đón du khách đến với thiên nhiên trong lành của lòng hồ Dầu Tiếng, trải nghiệm cắm trại Bằng Lăng Glamping, Đồng Sến Farmstay, thăm Di tích Rừng cao su thời Pháp thuộc và thưởng thức đặc sản OCOP danh tiếng.
        </p>
        <div class="mt-8 flex flex-wrap gap-3 sm:gap-4">
          <a href="/du-lich" class="bg-brand-500 hover:bg-brand-600 text-gray-950 font-bold px-6 py-3.5 rounded-xl shadow-lg hover:shadow-green-500/20 transition transform hover:-translate-y-0.5">
            Khám phá điểm đến →
          </a>
          <a href="/san-pham-ocop" class="bg-white/10 hover:bg-white/20 backdrop-blur-md text-white font-bold px-6 py-3.5 rounded-xl border border-white/20 transition">
            Gian hàng OCOP
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ĐIỂM ĐẾN DU LỊCH TIÊU BIỂU -->
  <section class="py-14 sm:py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-4 mb-10">
      <div>
        <span class="text-xs font-bold text-brand-700 uppercase tracking-widest">Trải nghiệm ấn tượng</span>
        <h2 class="text-2xl sm:text-3xl font-black text-gray-900 mt-1">Điểm Đến & Nghỉ Dưỡng Ven Hồ</h2>
        <p class="text-xs sm:text-sm text-gray-500 mt-1">Glamping ven hồ, farmstay sinh thái và di tích lịch sử tại xã Dầu Tiếng, TP. Hồ Chí Minh</p>
      </div>
      <a href="/du-lich" class="text-sm font-bold text-brand-700 hover:text-brand-800 transition flex items-center gap-1">
        Xem tất cả điểm đến <span>→</span>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {spots.map((spot) => (
        <SpotCard spot={spot} />
      ))}
    </div>
  </section>

  <!-- BẢN ĐỒ TƯƠNG TÁC SỐ -->
  <section class="py-6 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <InteractiveMap spots={spots} />
  </section>

  <!-- GIAN HÀNG SẢN PHẨM NÔNG SẢN & OCOP -->
  <section class="py-14 sm:py-20 bg-emerald-50/50 mt-12 border-y border-emerald-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-4 mb-10">
        <div>
          <span class="text-xs font-bold text-brand-700 uppercase tracking-widest">Đặc sản quê hương</span>
          <h2 class="text-2xl sm:text-3xl font-black text-gray-900 mt-1">Nông Sản & Sản Phẩm OCOP Tiêu Biểu</h2>
          <p class="text-xs sm:text-sm text-gray-500 mt-1">Sản phẩm đạt chuẩn 3 sao, 4 sao an toàn, rõ nguồn gốc xuất xứ tại xã Dầu Tiếng</p>
        </div>
        <a href="/san-pham-ocop" class="text-sm font-bold text-brand-700 hover:text-brand-800 transition flex items-center gap-1">
          Xem toàn bộ giỏ hàng OCOP <span>→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {ocopProducts.map((product) => (
          <OcopCard product={product} />
        ))}
      </div>
    </div>
  </section>

</Layout>
