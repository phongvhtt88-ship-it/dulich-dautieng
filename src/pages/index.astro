---
import Layout from '../layouts/Layout.astro';
import OcopCard from '../components/OcopCard.astro';
import SpotCard from '../components/SpotCard.astro';
import InteractiveMap from '../components/InteractiveMap.astro';
import { sanityClient } from '../lib/sanity';

// Dữ liệu điểm du lịch thực tế tại xã Dầu Tiếng, TP. Hồ Chí Minh
