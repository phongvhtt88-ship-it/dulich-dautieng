---
import { urlFor } from '../lib/sanity';

interface Props {
  product: {
    name: string;
    slug?: { current: string };
    starRating: string;
    mainImage?: any;
    producer: string;
    priceRange?: string;
    phoneContact?: string;
    zaloPhone?: string;
    standards?: string[];
  };
}

const { product } = Astro.props;
const slug = product.slug?.current || '#';
const phone = product.zaloPhone || product.phoneContact || '';
const zaloUrl = phone ? `https://zalo.me/${phone.replace(/\D/g, '')}` : '#';
const imageUrl = product.mainImage ? urlFor(product.mainImage).width(500).height(380).url() : 'https://images.unsplash.com/photo-1610832958506-aa56368176cf?w=600&auto=format&fit=crop';
---

<div class="bg-white rounded-2xl shadow-sm hover:shadow-lg transition-all duration-300 border border-gray-100 overflow-hidden flex flex-col group">
  <!-- Ảnh & Badge sao OCOP -->
  <div class="relative h-52 w-full bg-gray-100 overflow-hidden">
    <img 
      src={imageUrl} 
      alt={product.name} 
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      loading="lazy"
    />
    <div class="absolute top-3 right-3 bg-amber-500/90 backdrop-blur-md text-white text-xs font-black px-3 py-1 rounded-full shadow-md flex items-center gap-1">
      <span>★</span>
      <span>{product.starRating && product.starRating !== '0' ? `${product.starRating} SAO OCOP` : 'TIÊU BIỂU'}</span>
    </div>
  </div>

  <!-- Nội dung -->
  <div class="p-5 flex-1 flex flex-col justify-between">
    <div>
      <h3 class="font-bold text-gray-900 text-lg leading-snug group-hover:text-brand-700 transition">
        <a href={`/san-pham-ocop/${slug}`}>{product.name}</a>
      </h3>
      <p class="text-xs text-gray-500 mt-1.5 flex items-center gap-1">
        <svg class="w-3.5 h-3.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
        <span class="truncate">{product.producer}</span>
      </p>

      {product.standards && product.standards.length > 0 && (
        <div class="flex flex-wrap gap-1 mt-2.5">
          {product.standards.slice(0, 2).map((std) => (
            <span class="text-[10px] bg-green-50 text-green-700 font-semibold px-2 py-0.5 rounded-md border border-green-200">
              {std}
            </span>
          ))}
        </div>
      )}

      {product.priceRange && (
        <p class="text-sm font-bold text-brand-700 mt-3">{product.priceRange}</p>
      )}
    </div>

    <!-- Hành động -->
    <div class="mt-4 pt-3 border-t border-gray-100 flex items-center justify-between gap-2">
      <a 
        href={`/san-pham-ocop/${slug}`} 
        class="text-xs text-gray-600 font-semibold hover:text-brand-700 transition"
      >
        Xem câu chuyện →
      </a>
      {phone && (
        <a 
          href={zaloUrl}
          target="_blank" 
          rel="noopener noreferrer" 
          class="inline-flex items-center gap-1.5 bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold px-3.5 py-2 rounded-xl shadow-sm transition"
        >
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12c0 1.82.49 3.53 1.35 5L2 22l5.14-1.32C8.58 21.52 10.24 22 12 22c5.52 0 10-4.48 10-10S17.52 2 12 2z"/></svg>
          Đặt qua Zalo
        </a>
      )}
    </div>
  </div>
</div>
