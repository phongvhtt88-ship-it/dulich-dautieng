---
const navItems = [
  { label: 'Trang chủ', href: '/' },
  { label: 'Điểm đến du lịch', href: '/du-lich' },
  { label: 'Sản phẩm OCOP', href: '/san-pham-ocop' },
  { label: 'Tin tức & Lễ hội', href: '/tin-tuc' },
];
const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-gray-100 shadow-sm transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-20">
      
      <!-- Logo & Brand Name -->
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl bg-brand-700 flex items-center justify-center text-white font-bold text-xl shadow-md group-hover:bg-brand-800 transition flex-shrink-0">
          DT
        </div>
        <div>
          <span class="block text-xs font-semibold uppercase tracking-wider text-brand-700">Cổng Thông Tin</span>
          <span class="block text-base sm:text-lg font-black text-gray-900 group-hover:text-brand-700 transition">Du Lịch & OCOP Địa Phương</span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center gap-1 lg:gap-2">
        {navItems.map(item => {
          const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <a 
              href={item.href}
              class={`px-3 py-2 rounded-lg text-sm font-semibold transition ${
                isActive 
                  ? 'bg-brand-50 text-brand-800' 
                  : 'text-gray-600 hover:text-brand-700 hover:bg-gray-50'
              }`}
            >
              {item.label}
            </a>
          );
        })}
      </nav>

      <!-- Right Action: Hotline Call -->
      <div class="hidden sm:flex items-center gap-3">
        <a 
          href="tel:02743561000" 
          class="inline-flex items-center gap-2 bg-brand-600 hover:bg-brand-700 text-white text-xs lg:text-sm font-bold px-4 py-2 rounded-full shadow-sm transition transform hover:-translate-y-0.5"
        >
          <svg class="w-4 h-4 flex-shrink-0" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          <span>Hotline Du Khách</span>
        </a>
      </div>

      <!-- Mobile Hamburger Button -->
      <div class="flex md:hidden">
        <button 
          id="mobile-menu-btn"
          type="button" 
          class="p-2 rounded-lg text-gray-600 hover:text-gray-900 hover:bg-gray-100 focus:outline-none"
          aria-label="Toggle Menu"
        >
          <svg class="w-6 h-6" width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-gray-100 bg-white px-4 pt-3 pb-6 space-y-2">
    {navItems.map(item => (
      <a 
        href={item.href}
        class="block px-3 py-2.5 rounded-lg text-base font-semibold text-gray-700 hover:bg-brand-50 hover:text-brand-800 transition"
      >
        {item.label}
      </a>
    ))}
    <div class="pt-3 border-t border-gray-100">
      <a 
        href="tel:02743561000" 
        class="flex items-center justify-center gap-2 w-full bg-brand-600 text-white font-bold py-2.5 rounded-xl shadow text-sm"
      >
        Gọi Hotline Hỗ Trợ
      </a>
    </div>
  </div>
</header>

<script is:inline>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }
</script>
