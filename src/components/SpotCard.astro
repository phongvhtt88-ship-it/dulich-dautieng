---
import { urlFor } from '../lib/sanity';

interface Props {
  spot: {
    title: string;
    slug?: { current: string };
    category: string;
    thumbnail?: any;
    address: string;
    ticketPrice?: string;
    openHours?: string;
    googleMapsUrl?: string;
  };
}

const { spot } = Astro.props;
const slug = spot.slug?.current || '#';
const imageUrl = spot.thumbnail ? urlFor(spot.thumbnail).width(600).height(400).url() : 'https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=600&auto=format&fit=crop';

const categoryLabels = {
  heritage: 'Di tích lịch sử',
  ecotourism: 'Du lịch sinh thái',
  checkin: 'Điểm check-in',
  food: 'Ẩm thực địa phương',
  stay: 'Lưu trú / Homestay'
};
const categoryLabel = categoryLabels[spot.category] || 'Điểm tham quan';
---

<div class="bg-white rounded-2xl shadow-sm hover:shadow-lg transition-all duration-300 border border-gray-100 overflow-hidden flex flex-col group">
  <div class="relative h-56 w-full bg-gray-100 overflow-hidden">
    <img 
      src={imageUrl} 
      alt={spot.title} 
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      loading="lazy"
    />
    <div class="absolute top-3 left-3 bg-brand-800/90 backdrop-blur-md text-white text-xs font-semibold px-3 py-1 rounded-full shadow">
      {categoryLabel}
    </div>
    {spot.ticketPrice && (
      <div class="absolute bottom-3 right-3 bg-white/95 text-gray-900 text-xs font-bold px-2.5 py-1 rounded-lg shadow">
        {spot.ticketPrice}
      </div>
    )}
  </div>

  <div class="p-5 flex-1 flex flex-col justify-between">
    <div>
      <h3 class="font-bold text-gray-900 text-lg leading-snug group-hover:text-brand-700 transition">
        <a href={`/du-lich/${slug}`}>{spot.title}</a>
      </h3>
      <p class="text-xs text-gray-500 mt-2 flex items-start gap-1">
        <svg class="w-4 h-4 text-red-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        <span class="line-clamp-2">{spot.address}</span>
      </p>
    </div>

    <div class="mt-4 pt-3 border-t border-gray-100 flex items-center justify-between gap-2">
      <a 
        href={`/du-lich/${slug}`} 
        class="text-xs font-semibold text-brand-700 hover:underline"
      >
        Chi tiết điểm đến →
      </a>
      {spot.googleMapsUrl && (
        <a 
          href={spot.googleMapsUrl}
          target="_blank" 
          rel="noopener noreferrer" 
          class="inline-flex items-center gap-1 text-xs bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold px-3 py-1.5 rounded-lg transition"
        >
          <svg class="w-3.5 h-3.5 text-red-600" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 010-5 2.5 2.5 0 010 5z"/></svg>
          Chỉ đường
        </a>
      )}
    </div>
  </div>
</div>
